# Fuerza LF en todos los archivos de texto — evita CRLF de Windows
* text=auto eol=lf

*.sh         text eol=lf
*.java       text eol=lf
Jenkinsfile  text eol=lf
Dockerfile*  text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.xml        text eol=lf
*.sql        text eol=lf
*.md         text eol=lf
*.properties text eol=lf
*.txt        text eol=lf

*.war   binary
*.jar   binary
*.png   binary
*.jpg   binary
*.zip   binary
*.7z    binary
