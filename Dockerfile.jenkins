FROM jenkins/jenkins:lts-jdk17

USER root

# ── Instalar dependencias del sistema ─────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    maven \
    docker.io \
    curl \
    git \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

# ── Instalar plugins de Jenkins sin wizard ────────────────────────────────────
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false"
ENV JENKINS_OPTS="--argumentsRealm.passwd.admin=admin --argumentsRealm.roles.admin=admin"

# ── Copiar lista de plugins a instalar ────────────────────────────────────────
COPY jenkins-plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# ── Copiar configuración precargada de Jenkins ────────────────────────────────
COPY jenkins-config/jenkins.yaml /var/jenkins_home/jenkins.yaml
COPY jenkins-config/jobs/         /var/jenkins_home/jobs/

# ── Configurar credenciales y seguridad básica ────────────────────────────────
COPY jenkins-config/users/        /var/jenkins_home/users/
COPY jenkins-config/config.xml    /var/jenkins_home/config.xml

# ── Permisos ─────────────────────────────────────────────────────────────────
RUN chown -R jenkins:jenkins /var/jenkins_home

USER jenkins

EXPOSE 8080 50000
